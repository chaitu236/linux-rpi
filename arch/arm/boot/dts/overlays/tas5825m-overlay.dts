// Definitions for using tas5825m (speakers) and tlv320aic3254 (headphones)
//
// Both codecs hang off the one I2S bus and are declared as a single
// audio-graph-card2 multi-codec link, so they share one PCM device and both
// chips are clocked and streaming continuously.  Selecting an output is then a
// mixer write on an already-running codec rather than closing one PCM device
// and opening another.  See fragment@5 for why simple-audio-card cannot
// express this and what the arrangement costs.
//
// The aic3254 has no MCLK routed to it on this board; it derives its clocks
// from BCLK via its PLL, which requires the Pi to stay bitclock/frame master
// so that BCLK keeps running while the codec is streaming.
//
// The aic3254 is reset over GPIO 7, which bcm2711-rpi-cm4.dts hands to SPI0 as
// chip select CE1.  SPI0 claims the pin first and the codec then fails to
// probe with -EBUSY, so CE1 is released here in the same way the stock
// spi0-1cs overlay does.  Only CE0 is used on this board.
/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2835";

	fragment@0 {
		target = <&i2s>;
		__overlay__ {
			status = "okay";
		};
	};

	/* Release GPIO 7 (SPI0 CE1) for use as the aic3254 reset line. */
	fragment@1 {
		target = <&spi0_cs_pins>;
		__overlay__ {
			brcm,pins = <8>;
		};
	};

	fragment@2 {
		target = <&spi0>;
		__overlay__ {
			cs-gpios = <&gpio 8 1>;
		};
	};

	fragment@3 {
		target = <&spidev1>;
		__overlay__ {
			status = "disabled";
		};
	};

	fragment@4 {
		target = <&i2c1>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";

			tas5825: tas5825@4c {
				#sound-dai-cells = <0>;
				compatible = "ti,tas5805m";
				reg = <0x4c>;
				pdn-gpios = <&gpio 16 0>;
				status = "okay";
			};

			tlv320aic3254: tlv320aic3254@18 {
				#sound-dai-cells = <0>;
				compatible = "ti,tlv320aic32x4";
				reg = <0x18>;
				reset-gpios = <&gpio 7 0>;

				/*
				 * No clocks/clock-names: there is no MCLK on
				 * this board, so the driver runs the PLL from
				 * BCLK.
				 *
				 * LDOIN is fed from 3V3 and the internal LDOs
				 * generate AVDD/DVDD, so only iov and ldoin
				 * are supplied here.
				 */
				iov-supply = <&vdd_3v3_reg>;
				ldoin-supply = <&vdd_3v3_reg>;

				status = "okay";
			};
		};
	};

	/*
	 * One DAI link carrying both codecs, so they share a single PCM device.
	 *
	 * This is audio-graph-card2 rather than simple-audio-card for exactly
	 * one reason: simple-card.c hardcodes li->num[].codecs = 1 (lines 587
	 * and 617), so no device tree can give it two codecs on one link.
	 * audio-graph-card2 counts them with graph_counter() instead and
	 * supports a real multi-codec link.
	 *
	 * Why that matters is not the wiring -- both chips have always shared
	 * the I2S lines -- but what ASoC does with it. As two links they are two
	 * PCM devices, and only one can be open at a time behind the single I2S
	 * block, so switching means closing one and opening the other. Worse,
	 * the idle codec's link is not running at all: the aic3254 has no MCLK
	 * on this board and runs its PLL from BCLK, so with no stream on its
	 * link its clocks are down and unmuting it produces silence, not audio.
	 *
	 * On one link ASoC applies hw_params and trigger to every codec DAI, so
	 * both chips are clocked and streaming continuously and selecting an
	 * output is a mixer write on an already-running codec. No reopen, no
	 * fluidsynth restart, nothing added to the real-time path.
	 *
	 * The cost, accepted deliberately: in the playback direction
	 * soc_pcm_hw_update_format() intersects the formats of every codec on
	 * the link (soc-pcm.c:553), so the tas5805m pins the link to S32_LE at
	 * 48kHz even for headphone-only playback. The synth runs at 48kHz
	 * anyway and plug converts. Capture is unaffected:
	 * snd_soc_runtime_calc_hw() skips codecs that do not support the
	 * stream's direction (soc-pcm.c:607), so the playback-only amplifier
	 * drops out of a capture stream and only the aic3254 constrains it.
	 *
	 * No per-codec "prefix" here. audio-graph-card2 does parse one, but
	 * only for DPCM back-ends -- the gtype == GRAPH_DPCM gate at
	 * audio-graph-card2.c:487, which a multi link never reaches because
	 * __graph_get_type() folds GRAPH_MULTI into GRAPH_NORMAL (line 294). A
	 * prefix property would be silently ignored. It is not needed: the two
	 * codecs' control names are already distinct, "Master Playback Volume"
	 * and "Master Playback Switch" on the amplifier against "PCM Playback
	 * Volume" and "HP DAC Playback Switch" on the codec.
	 */
	fragment@5 {
		target = <&sound>;
		__overlay__ {
			status = "okay";
			compatible = "audio-graph-card2";

			/*
			 * One word, deliberately. ALSA derives the card id --
			 * what aplay -D, asound.conf and amixer -c match on --
			 * from this with retrieve_id_from_card_name(), which
			 * takes the last whitespace-separated word
			 * (sound/core/init.c:676). "IsoKbd Audio" therefore
			 * gave the id "Audio", which is both uninformative and
			 * liable to collide; a colliding id silently gets a
			 * "_1" suffix (init.c:752) and every reference to it by
			 * name then misses.
			 */
			label = "IsoKbd";

			links = <&isokbd_i2s_port>;

			/*
			 * Pin both outputs as DAPM endpoints that are always
			 * connected. Without this nothing downstream of either
			 * DAC is ever powered: the codec stays at bias level
			 * Off with its PLL, NDAC and MDAC down even while the
			 * PCM says it is running.
			 *
			 * Both are pinned, not just the selected one, because
			 * the whole point of the shared link is that both chips
			 * stay live and selection is a mixer write. The
			 * DAC-to-output-mixer switches are still runtime mixer
			 * controls and default to off; those are set from the
			 * saved ALSA state rather than here.
			 */
			widgets = "Headphone", "Headphone Jack",
				  "Speaker",   "Speakers";
			routing = "Headphone Jack", "HPL",
				  "Headphone Jack", "HPR",
				  "Speakers",       "OUT";

			/*
			 * Two things here are load-bearing and neither is
			 * obvious. Both were found on hardware, by tracing the
			 * parse; both fail the same silent way, with the card
			 * simply absent and "Neither Component name/of_node
			 * are set" in dmesg.
			 *
			 * 1. Only the codec side is multi. The CPU side is the
			 *    I2S node's own port, named directly by "links".
			 *    Wrapping the single CPU in its own multi {}
			 *    ports@0 does not bind -- identically with one
			 *    codec as with two, so it is the CPU side at fault
			 *    rather than the codec count.
			 *
			 * 2. The ports are declared in REVERSE order, port@2
			 *    first and port@0 last. __of_attach_node() inserts
			 *    each overlay node at the HEAD of its parent's
			 *    child list (drivers/of/dynamic.c: "np->sibling =
			 *    np->parent->child"), so the sibling chain comes
			 *    out in reverse declaration order. Declared 0,1,2
			 *    the chain starts at port@0 and immediately ends:
			 *    graph_get_next_multi_ep() asks for port@0's next
			 *    sibling, gets NULL, and both codec slots are left
			 *    empty.
			 *
			 * The second one is worth dwelling on, because the
			 * device tree looks perfect either way -- /proc shows
			 * all three ports with resolving remote-endpoints --
			 * and because graph_counter() disagrees with the walk.
			 * Counting uses of_graph_get_endpoint_count(), which
			 * searches by name and finds all three; parsing walks
			 * prev->sibling from port@0 and finds none. That gap
			 * is what "codecs=2" alongside "idx 0: no more
			 * endpoints" means, and it is why the count and the
			 * parse can disagree about the same node.
			 *
			 * This affects overlays only. A codec pair spelled the
			 * same way inside a base DTS needs no reversal.
			 */
			multi {
				/*
				 * port@0 is the link itself -- the far end of
				 * the CPU's endpoint -- and the ports after it
				 * are the codecs. graph_counter() returns the
				 * endpoint count minus that first one, so this
				 * is two codecs.
				 */
				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					/*
					 * Declared last-to-first on purpose. See
					 * the comment above: the kernel
					 * prepends each overlay node to its
					 * parent's child list, so the sibling
					 * chain ends up in reverse declaration
					 * order, and this is what puts port@0
					 * at the head with port@1 and port@2
					 * after it.
					 */
					/* The headphone codec. */
					port@2 {
						reg = <2>;
						isokbd_multi_aic_ep: endpoint {
							remote-endpoint = <&isokbd_aic_ep>;
						};
					};
					/* The amplifier. */
					port@1 {
						reg = <1>;
						isokbd_multi_tas_ep: endpoint {
							remote-endpoint = <&isokbd_tas_ep>;
						};
					};
					port@0 {
						reg = <0>;
						isokbd_multi_codec_ep: endpoint {
							remote-endpoint = <&isokbd_i2s_ep>;
						};
					};
				};
			};
		};
	};

	/*
	 * The Pi stays bitclock and frame master. That is not a preference: the
	 * aic3254 has no MCLK routed on this board and derives everything from
	 * BCLK through its PLL, so BCLK has to keep running whenever the codec
	 * is streaming.
	 */
	fragment@6 {
		target = <&i2s>;
		__overlay__ {
			isokbd_i2s_port: port {
				bitclock-master;
				frame-master;
				dai-format = "i2s";

				isokbd_i2s_ep: endpoint {
					remote-endpoint = <&isokbd_multi_codec_ep>;
				};
			};
		};
	};

	fragment@7 {
		target = <&tas5825>;
		__overlay__ {
			port {
				isokbd_tas_ep: endpoint {
					remote-endpoint = <&isokbd_multi_tas_ep>;
				};
			};
		};
	};

	fragment@8 {
		target = <&tlv320aic3254>;
		__overlay__ {
			port {
				isokbd_aic_ep: endpoint {
					remote-endpoint = <&isokbd_multi_aic_ep>;
				};
			};
		};
	};
};
